{
  "name": "devweave-backend",
  "version": "1.0.0",
  "description": "DevWeave Internal Developer Platform Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
